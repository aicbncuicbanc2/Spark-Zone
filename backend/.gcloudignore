# Controls what gcloud uploads as the Cloud Build source archive - separate
# from .dockerignore, which only governs the docker build step *after* the
# upload. Without this file, the entire local venv/ (3.3 GB) was being
# uploaded on every deploy, which is almost certainly why every prior deploy
# attempt failed or hung - the build never even reached the actual Docker
# build step within any reasonable time.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
venv/
.venv/
env/
.env
.env.local
*.env
!.env.example
.git/
.gitignore
tests/
scripts/
supabase/
*.md
docs/
.DS_Store
Thumbs.db
*.log
gcp-credentials*.json
