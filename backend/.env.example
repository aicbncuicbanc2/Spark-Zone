# =============================================================================
# Copy to .env and fill in. NEVER commit .env - it is already gitignored.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=local              # local | staging | production
LOG_LEVEL=INFO
PORT=8080
# Comma-separated origins. Expo dev clients connect from arbitrary LAN IPs,
# so "*" is fine locally. Lock this down before submission.
CORS_ORIGINS=*

# --- Supabase ----------------------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Dashboard -> Project Settings -> API -> service_role.
# BYPASSES Row Level Security. Server-side only. Never ship to the app.
SUPABASE_SERVICE_ROLE_KEY=
# ONLY for legacy HS256 projects (Project Settings -> API -> JWT Secret).
# This project signs with ES256 (asymmetric, verified via JWKS), so leave it
# blank - confirmed against the project's /auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated

# --- Cloudinary --------------------------------------------------------------
# Dashboard -> Product Environment Credentials (split into three fields, not the
# single CLOUDINARY_URL string).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=expiry-guardian

# --- Google Vision (fallback OCR) --------------------------------------------
# Path to the service account JSON inside the container. On Cloud Run, prefer
# the runtime service account and leave this blank.
GOOGLE_APPLICATION_CREDENTIALS=
VISION_ENABLED=true

# --- OCR pipeline ------------------------------------------------------------
OCR_PRIMARY_ENGINE=paddleocr
# Below this confidence, pipeline.py escalates to Google Vision.
OCR_CONFIDENCE_THRESHOLD=0.65
OCR_MAX_IMAGE_BYTES=8388608

# --- Firebase Cloud Messaging ------------------------------------------------
# Firebase Console -> Project Settings -> Service Accounts -> Generate new key.
# Paste the JSON as a single line, or mount it as a secret and give the path.
FCM_SERVICE_ACCOUNT_JSON=
FCM_ENABLED=true

# --- Internal ----------------------------------------------------------------
# Shared secret for /v1/internal/* when the caller is not Cloud Scheduler OIDC.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SWEEP_SECRET=
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# --- Test accounts (integration tests) --------------------------------------
# Password for the seeded dev accounts described in README.md.
# Ask a teammate for the value, or reset it in the Supabase dashboard.
TEST_USER_PASSWORD=
