# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Backend API base URL. A Cloudflare tunnel while the backend runs on a
# teammate's laptop — ask them for the current URL, it changes on every
# restart. Becomes the Cloud Run URL once deployed, with no code change.
EXPO_PUBLIC_API_BASE_URL=https://<ask-your-teammate>.trycloudflare.com

# Supabase project (see docs/frontend-brief.md). The anon key is the
# publishable key protected by row-level security, so it's safe to ship in
# the app bundle, but we still keep it out of git like any other config.
EXPO_PUBLIC_SUPABASE_URL=https://vrdanstqtiuqtdfychcr.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_KHO1yoGo9V9JLV8FSbWuqg_vCe85yyF

# true = screens read docs/api-samples/ (copied into mocks/) instead of
# calling the backend. Set to false once the backend is reachable.
EXPO_PUBLIC_USE_MOCKS=true
